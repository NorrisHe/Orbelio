#version 450
layout(local_size_x=256) in;
layout(binding=0, std430) readonly buffer Ranges { uint ranges[]; };
layout(binding=1, std430) readonly buffer Count { uint count; };
layout(binding=2, std430) buffer Totals { uint maximum; uint references; uint totals[]; };
layout(push_constant) uniform Params { uint tiles; } p;
shared uint sums[256];
shared uint maxima[256];
void main() {
    uint tile=gl_GlobalInvocationID.x, lane=gl_LocalInvocationID.x;
    uint n=0, total=0;
    if (tile<p.tiles && count>0) {
        n=ranges[tile+1]-ranges[tile];
        total=totals[tile]+n;
        totals[tile]=total;
    }
    sums[lane]=n; maxima[lane]=total; barrier();
    for (uint stride=128;stride>0;stride>>=1) {
        if (lane<stride) {
            sums[lane]+=sums[lane+stride];
            maxima[lane]=max(maxima[lane],maxima[lane+stride]);
        }
        barrier();
    }
    if (lane==0) { atomicMax(maximum,maxima[0]); atomicAdd(references,sums[0]); }
}
