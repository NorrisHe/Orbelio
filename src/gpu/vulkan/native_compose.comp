#version 460
layout(local_size_x=16,local_size_y=16) in;
layout(set=0,binding=0) uniform sampler2D accumulated;
layout(set=0,binding=1,rgba8) writeonly uniform image2D target;
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel,textureSize(accumulated,0)))) return;
    vec4 value = texelFetch(accumulated,pixel,0);
    imageStore(target,pixel,vec4(value.rgb+value.a*vec3(0.035,0.045,0.065),1));
}
