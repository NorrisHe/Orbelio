#version 460
#extension GL_GOOGLE_include_directive : require
#define SORT_CONTROL_BINDING 2
#include "native_sort_parameters.glsl"
layout(local_size_x = 256) in;
layout(set=0,binding=0,std430) readonly buffer Keys { uint keys[]; };
layout(set=0,binding=1,std430) writeonly buffer Histogram { uint histogram[]; };
shared uint bins[radix];
void main() {
    SortParameters p = sortParameters();
    if (p.count == 0 || gl_WorkGroupID.x >= p.groups) return;
    uint bin = gl_LocalInvocationIndex;
    if (bin<p.activeRadix) bins[bin] = 0;
    barrier();
    uint index = gl_GlobalInvocationID.x;
    if (index < p.count && validSortKey(keys[index]))
        atomicAdd(bins[(keys[index] >> p.shift) & (p.activeRadix-1)],1);
    barrier();
    if (bin<p.activeRadix) histogram[histogramIndex(gl_WorkGroupID.x,bin,p.activeRadix)] = bins[bin];
}
