#version 460
#extension GL_GOOGLE_include_directive : require
#define PROJECT_SPLATS
#define CAMERA_BINDING 3
#include "native_project_parameters.glsl"
#include "native_sh.glsl"

layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) writeonly buffer DepthKeys { uint keys[]; };
layout(set = 0, binding = 1, std430) writeonly buffer Indices { uint indices[]; };
layout(set = 0, binding = 2, std430) buffer Counters { uint counters[]; };

#ifdef NORMAL_OUTPUT
layout(set = 0, binding = 4, std430) writeonly buffer Normals { vec4 normals[]; };

vec3 facingNormal(mat3 rotation, vec3 scales, vec3 away) {
    uint axis = scales.x <= scales.y ? 0 : 1;
    if (scales.z < scales[axis]) axis = 2;
    vec3 normal = normalize(rotation[axis]);
    float magnitude = max(abs(away.x),max(abs(away.y),abs(away.z)));
    return dot(normal,away/magnitude)>0 ? -normal : normal;
}
#endif

const float alphaCutoff = 0.5 / 255.0;
const float dilation = 0.3;

mat3 orientation(vec4 q) {
    q = normalize(q);
    float w = q.x;
    float x = q.y;
    float y = q.z;
    float z = q.w;
    return mat3(vec3(1 - 2 * (y*y + z*z), 2 * (x*y + w*z), 2 * (x*z - w*y)),
                vec3(2 * (x*y - w*z), 1 - 2 * (x*x + z*z), 2 * (y*z + w*x)),
                vec3(2 * (x*z + w*y), 2 * (y*z - w*x), 1 - 2 * (x*x + y*y)));
}

float stableLength(vec4 value) {
    float largest = max(max(abs(value.x), abs(value.y)), max(abs(value.z), abs(value.w)));
    return largest == 0 ? 0 : largest * length(value / largest);
}

struct Footprint {
    vec2 sigma;
    vec3 whitening;
    float compensation;
};

Footprint footprint(mat3 rotation, vec3 scales, vec3 point) {
    vec2 focal = camera.intrinsics.xy;
    vec2 margin = 0.15*p.viewport.xy;
    vec2 slope = clamp(point.xy / point.z, (-camera.intrinsics.zw-margin)/focal,
                       (p.viewport.xy-camera.intrinsics.zw+margin)/focal);
    vec3 jx = camera.clipping.z != 0 ? focal.x*p.right.xyz :
        focal.x / point.z * (p.right.xyz - slope.x * p.forward.xyz);
    vec3 jy = camera.clipping.z != 0 ? focal.y*p.down.xyz :
        focal.y / point.z * (p.down.xyz - slope.y * p.forward.xyz);
    vec3 x;
    vec3 y;
    for (uint axis = 0; axis < 3; ++axis) {
        x[axis] = dot(jx, rotation[axis]) * exp(scales[axis]);
        y[axis] = dot(jy, rotation[axis]) * exp(scales[axis]);
    }
    vec2 scale = max(vec2(sqrt(dilation)), vec2(max(max(abs(x.x),abs(x.y)),abs(x.z)),
                                               max(max(abs(y.x),abs(y.y)),abs(y.z))));
    x /= scale.x;
    y /= scale.y;
    vec2 blur = sqrt(dilation) / scale;
    float xx = dot(x,x);
    float yy = dot(y,y);
    float a = xx + blur.x*blur.x;
    float c = yy + blur.y*blur.y;
    // Cauchy-Binet avoids subtracting nearly equal covariance products for thin splats.
    vec3 minors = cross(x,y);
    float blurred = stableLength(vec4(blur.x*sqrt(yy), blur.y*sqrt(xx), blur.x*blur.y, 0));
    float determinantRoot = stableLength(vec4(minors,blurred));
    Footprint result;
    result.sigma = scale * sqrt(vec2(a,c));
    result.whitening = vec3(1.0/result.sigma.x, (scale.y/scale.x)*(dot(x,y)/a),
                            (sqrt(a)/scale.y)/determinantRoot);
    result.compensation = stableLength(vec4(minors,0)) / determinantRoot;
    return result;
}

void addCounter64(uint word, uint value) {
    uint previous = atomicAdd(counters[word],value);
    if (previous>0xffffffffu-value) atomicAdd(counters[word+1],1);
}

void collectDiagnostics(vec2 mean, vec2 radius, Footprint shape, float opacity, float cutoffPower) {
    vec2 lower = floor(clamp(mean-radius,vec2(0),p.viewport.xy));
    vec2 upper = ceil(clamp(mean+radius,vec2(0),p.viewport.xy));
    uvec2 span = uvec2(max(upper-lower,vec2(0)));
    uint pixels = span.x*span.y;
    const float maximumFloat = 3.402823466e38;
    float inverseRoot = shape.whitening.x*shape.whitening.z;
    float area = inverseRoot>0 ? min(6.28318530718*cutoffPower/inverseRoot,maximumFloat) : maximumFloat;
    addCounter64(1,pixels);
    atomicMax(counters[3],pixels);
    atomicMax(counters[4],floatBitsToUint(area));
    addCounter64(5,uint(round(opacity*65535)));
    if (opacity>=0.99) atomicAdd(counters[7],1);
    float axisRadius = min(max(radius.x,radius.y),maximumFloat);
    atomicMax(counters[8],floatBitsToUint(axisRadius));
    if (axisRadius>512.5) atomicAdd(counters[9],1);
    // Clip the geometric area estimate before fixed-point accumulation, preserving 64-bit sums.
    addCounter64(10,uint(round(min(area,float(pixels))*16)));
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= p.controls.x) return;
    indices[index] = index;
    keys[index] = 0xffffffffu;
    p.projected.values[index].color = vec4(0, 0, 0, -1);
    bool temporal = (p.controls.w & 4u) != 0;
    vec4 position = p.positions.values[index*(temporal ? 2 : 1)];
    float sourceOpacity = 1.0/(1.0+exp(-position.w));
    if (temporal) {
        vec4 motion = p.positions.values[index*2+1];
        // Split time preserves small seeks near a large absolute timestamp.
        float dt = (p.forward.w-motion.w) + p.eye.w;
        float variance = p.orientations.values[index*2+1].w;
        float weight = exp(-0.5*dt*dt/variance);
        if (weight <= 0.05) return;
        position.xyz += motion.xyz*dt;
        sourceOpacity = clamp(sourceOpacity*weight,1e-6,1.0-1e-6);
    }
    vec3 relative = position.xyz-p.eye.xyz;
    vec3 point = vec3(dot(relative,p.right.xyz), dot(relative,p.down.xyz), dot(relative,p.forward.xyz));
    // Finite source coordinates can overflow during the view transform and produce NaN.
    if (!(point.z > camera.clipping.x && point.z < camera.clipping.y)) return;
    vec2 mean = camera.intrinsics.xy*(point.xy/(camera.clipping.z != 0 ? 1.0 : point.z)) + camera.intrinsics.zw;
    vec3 scales = p.orientations.values[index*2+1].xyz;
#ifdef NORMAL_OUTPUT
    mat3 rotation = orientation(p.orientations.values[index*2]);
    Footprint shape = footprint(rotation,scales,point);
#else
    Footprint shape = footprint(orientation(p.orientations.values[index*2]), scales, point);
#endif
    float opacity = sourceOpacity;
    if ((p.controls.w & 1u) != 0)
        opacity *= shape.compensation;
    if (opacity < alphaCutoff) return;
    float cutoffPower = log(opacity/alphaCutoff);
    float power = max(4.0, cutoffPower);
    vec2 radius = sqrt(2*power)*shape.sigma;
    if (any(lessThan(mean+radius, vec2(0))) || any(greaterThan(mean-radius, p.viewport.xy))) return;
    vec3 rgb;
    if (p.controls.z == 0) {
        rgb=vec3(0);
        if ((p.controls.w&16u)==0) rgb=color(index,camera.clipping.z!=0 ? p.forward.xyz : relative);
    }
    else {
        float value = p.controls.z == 1 ? point.z : p.controls.z == 2 ? sourceOpacity : max(scales.x,max(scales.y,scales.z));
        float gray = p.controls.z == 2 ? value : (value-p.right.w)/(p.down.w-p.right.w);
        rgb = vec3(clamp(gray,0,1));
    }
    p.projected.values[index].rectangle = vec4(mean, radius);
    p.projected.values[index].conicOpacity = vec4(shape.whitening,opacity);
    p.projected.values[index].color = vec4(rgb,cutoffPower);
#ifdef NORMAL_OUTPUT
    normals[index] = vec4(facingNormal(rotation,scales,camera.clipping.z!=0 ? p.forward.xyz : relative),0);
#endif
    keys[index] = floatBitsToUint(point.z);
    if ((p.controls.w & 2u) != 0) atomicAdd(counters[0],1);
    if ((p.controls.w & 8u) != 0) collectDiagnostics(mean,radius,shape,opacity,cutoffPower);
}
